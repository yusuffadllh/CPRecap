<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy auto-backup rules (used on API < 31).
   Sensitive data is excluded from backup. On API 31+ see data_extraction_rules.xml.
   Note: allowBackup="false" in the manifest disables backup entirely; these
   rules are a defense-in-depth safeguard.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore/" />
    <exclude domain="database" path="." />
</full-backup-content>
