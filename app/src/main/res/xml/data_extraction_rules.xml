<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for SmartFinance (CPRecap).
   Sensitive data (encrypted API keys in DataStore, transaction database) is
   excluded from both cloud backup and device-to-device transfer so it cannot
   be extracted off-device. Note: allowBackup is also set to "false" in the
   manifest, which disables cloud/adb backup entirely; these rules act as a
   defense-in-depth safeguard.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Never back up secrets or the transactions database. -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
