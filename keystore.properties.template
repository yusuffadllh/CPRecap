# ============================================================================
# Release signing configuration for SmartFinance (CPRecap)
#
# 1. Copy this file to "keystore.properties" (same folder, no ".template").
# 2. Fill in the values below with your own keystore details.
# 3. NEVER commit keystore.properties or your .jks/.keystore file to git.
#    (Both are already ignored in .gitignore.)
#
# To create a release keystore, run (from the project root):
#
#   keytool -genkeypair -v -keystore release.jks -alias smartfinance ^
#     -keyalg RSA -keysize 2048 -validity 10000
#
# (On Windows PowerShell use backtick ` instead of ^ for line breaks, or put
#  it all on one line.)
# ============================================================================

# Path to the keystore file, relative to the project root (or absolute).
storeFile=release.jks

# Password for the keystore file.
storePassword=CHANGE_ME

# The alias of the key inside the keystore.
keyAlias=smartfinance

# Password for that specific key (often same as storePassword).
keyPassword=CHANGE_ME
